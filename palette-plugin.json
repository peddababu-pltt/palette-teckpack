{
  "manifest_version": "1",
  "id": "techpack",
  "name": "Techpack Studio",
  "version": "1.1.16",
  "developer": "Your Team",
  "category": "Productivity",
  "tagline": "Photo to sewing-pattern techpack pipeline",
  "description": "Photo -> flat sketch -> seasonal variations -> parts SVG -> sewing pattern -> spec, run directly by this plugin's backend.",
  "icon": "Shirt",
  "gradient": {
    "bg": "linear-gradient(135deg, #8B5CF6, #EC4899)",
    "text": "#fff"
  },
  "sdk": {
    "frontend": "^0.1.34",
    "backend": "^0.1.17"
  },
  "platform": {
    "min_version": "0.1.0"
  },
  "capabilities": {
    "frontend": true,
    "backend": true,
    "database": false,
    "webhooks": false,
    "scheduled_jobs": false,
    "file_uploads": true,
    "external_network": [
      "router-api.pltt.ai",
      "three.ws",
      "api.anthropic.com",
      "generativelanguage.googleapis.com"
    ]
  },
  "frontend": {
    "entry": "./frontend/src/index.tsx",
    "sandbox": true
  },
  "backend": {
    "entry": "./backend/api/main.py"
  },
  "data_scope": "organization",
  "permissions": [
    "resources:read",
    "resources:write",
    "data_rooms:read",
    "data_rooms:write"
  ],
  "public_routes": [
    "/health",
    "/assets/pdf.worker.min.mjs"
  ],
  "platform_services": {
    "llm": {
      "models": [
        "claude-sonnet-4-6",
        "gemini-2.5-pro",
        "gemini-2.5-flash"
      ],
      "max_output_tokens": 16000,
      "max_images": 40
    }
  }
}
