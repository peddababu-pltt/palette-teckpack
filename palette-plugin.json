{
  "manifest_version": "1",
  "id": "techpack",
  "name": "Techpack Studio",
  "version": "1.1.0",
  "developer": "Your Team",
  "category": "Productivity",
  "tagline": "Photo to sewing-pattern techpack pipeline",
  "description": "Photo -> flat sketch -> seasonal variations -> parts SVG -> sewing pattern -> spec, run directly by this plugin's backend.",
  "icon": "Shirt",
  "gradient": {
    "bg": "linear-gradient(135deg, #8B5CF6, #EC4899)",
    "text": "#fff"
  },
  "sdk": {
    "frontend": "^0.1.30",
    "backend": "^0.1.9"
  },
  "platform": {
    "min_version": "0.1.0"
  },
  "capabilities": {
    "frontend": true,
    "backend": true,
    "database": false,
    "webhooks": false,
    "scheduled_jobs": false,
    "file_uploads": true,
    "external_network": [
      "api.anthropic.com",
      "generativelanguage.googleapis.com",
      "router-api.pltt.ai"
    ]
  },
  "frontend": {
    "entry": "./frontend/src/index.tsx",
    "sandbox": true
  },
  "backend": {
    "entry": "./backend/api/main.py"
  },
  "data_scope": "organization",
  "permissions": [
    "resources:read",
    "resources:write"
  ],
  "public_routes": [
    "/health",
    "/assets/pdf.worker.min.mjs"
  ]
}
