# Palette local developer secrets — read via ctx.secret(...) in
# backend/api/main.py (PLUGIN_SECRET_KEYS). This file is for `pltt dev` only
# and is gitignored as .palette/.env.local — copy it there, don't commit it.

# Palette LLM gateway key: serves every Claude / Gemini call in the pipeline
# (via backend/api/llm_bridge.py). Playground: https://llm.pltt.dev/playground
PALETTE_API_KEY=
PALETTE_LLM_BASE_URL=https://llm.pltt.dev
# Same key/URL again: `pltt publish` skips PALETTE_* keys, so the hosted app
# reads these instead.
TECHPACK_LLM_API_KEY=
TECHPACK_LLM_BASE_URL=https://llm.pltt.dev

# Optional: LLM router in front of the above, if you're using one instead of
# calling the providers directly.
LLM_ROUTER_API_KEY=
LLM_ROUTER_BASE_URL=
LLM_ROUTER_UPSCALE_URL=