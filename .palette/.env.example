# Palette local developer secrets.
# This file is for pltt dev only and must not be committed.

# app.py's own bind address in local dev (`uvicorn app:app` in the repo root).
# For sandbox/production, use app.py's public URL and add that host to
# palette-plugin.json's capabilities.external_network.
TECHPACK_HOST=http://localhost:8000

# Must match TECHPACK_API_TOKEN in the repo root's .env — app.py checks this
# same value on incoming requests.
TECHPACK_API_TOKEN=


